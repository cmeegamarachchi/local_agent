# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=letta-openai

# ---------------------------------------------------------------------------
# Local agent project directory
# ---------------------------------------------------------------------------

EXTERNAL_LLM_ROOT=/q/projects/app-solve/llm

# ---------------------------------------------------------------------------
# OpenAI - hosted inference provider
# ---------------------------------------------------------------------------

# Required. Validated by rebuild-letta-agent-stack.sh before anything is
# built or deployed. Never commit a real key; this file is the tracked
# example only, the working .env is gitignored.
OPEN_AI_API_KEY=sk-...A

# ---------------------------------------------------------------------------
# Letta container
# ---------------------------------------------------------------------------

LETTA_IMAGE=local/letta-mcp-openai:0.1.38
LETTA_CONTAINER_NAME=letta-openai
LETTA_BUILD_CONTEXT=.
LETTA_DOCKERFILE=Dockerfile.letta

# Use 127.0.0.1 for local-only access, or the machine's LAN IP if your
# application runs on another computer.
# Distinct from the letta-local-qwen3 stack's port (8283) so both stacks can
# run at the same time.
LETTA_BIND_ADDRESS=127.0.0.1
LETTA_PORT=8284
LETTA_URL=http://host.docker.internal:8284
LETTA_ACCEPTABLE_ORIGINS=http://localhost:5173

LETTA_SECURE=true
LETTA_SERVER_PASSWORD=replace-with-a-long-random-password

LETTA_MEM_LIMIT=4g
LETTA_MEMSWAP_LIMIT=4g

# Hosted OpenAI models respond much faster than a local box, so these can be
# shorter than the local-qwen3 stack's timeouts.
LETTA_LLM_REQUEST_TIMEOUT_SECONDS=120
LETTA_LLM_STREAM_TIMEOUT_SECONDS=300

LETTA_AGENT_NAME=openai-agent
LETTA_AGENT_TIMEZONE=Australia/Perth

# Letta-native provider handles. Must start with "openai/".
LETTA_MODEL=openai/gpt-4o-mini
LETTA_EMBEDDING_HANDLE=openai/text-embedding-3-small

# gpt-4o-mini's context window; adjust if you change LETTA_MODEL.
LETTA_CONTEXT_WINDOW_LIMIT=128000


# ---------------------------------------------------------------------------
# MCP
# ---------------------------------------------------------------------------

MCP_SERVER_NAME=business-mcp-bridge-openai
MCP_DISABLE_STDIO=false

# Update to the endpoint of your existing business MCP server.
BUSINESS_MCP_URL=http://host.docker.internal:5136/mcp

MCP_REMOTE_HOME=/var/lib/mcp-remote
MCP_CONNECT_TO_SERVER_TIMEOUT=120
MCP_LIST_TOOLS_TIMEOUT=120
MCP_EXECUTE_TOOL_TIMEOUT=120


# ---------------------------------------------------------------------------
# Bootstrap script
# ---------------------------------------------------------------------------

CONNECT_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=120
AGENT_PAGE_SIZE=200
MCP_TOOL_WAIT_SECONDS=120
MCP_TOOL_POLL_SECONDS=5

# "matching" removes only the configured agent and MCP server names.
# Use "all" only when deliberately clearing the Letta server.
LETTA_CLEANUP_SCOPE=matching

MCP_REMOTE_COMMAND=/usr/local/bin/letta-mcp-remote
MCP_REMOTE_TRANSPORT=http-only
