# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=letta-local

# ---------------------------------------------------------------------------
# Local agent project directory
# ---------------------------------------------------------------------------

EXTERNAL_LLM_ROOT=/q/projects/app-solve/llm

# ---------------------------------------------------------------------------
# Ollama - local OpenAI-compatible inference provider
# ---------------------------------------------------------------------------

OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_CONTAINER_NAME=ollama
OLLAMA_INIT_CONTAINER_NAME=ollama-model-init

# Keep on 127.0.0.1 unless another machine needs direct access to Ollama.
# If you expose this to the LAN, put authentication/TLS in front of it.
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434

# Recommended 16 GB VRAM model for long context + tool calling.
OLLAMA_CHAT_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# 64K physical model context; Letta is capped to the same value below.
OLLAMA_CONTEXT_LENGTH=65536

# Long-context memory controls.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m

# Keep inference entirely local.
OLLAMA_NO_CLOUD=1


# ---------------------------------------------------------------------------
# Letta container
# ---------------------------------------------------------------------------

LETTA_IMAGE=local/letta-mcp:0.1.38
LETTA_CONTAINER_NAME=letta
LETTA_BUILD_CONTEXT=.
LETTA_DOCKERFILE=Dockerfile.letta

# Use 127.0.0.1 for local-only access, or the machine's LAN IP if your
# application runs on another computer.
LETTA_BIND_ADDRESS=127.0.0.1
LETTA_PORT=8283
LETTA_URL=http://127.0.0.1:8283

LETTA_ACCEPTABLE_ORIGINS=http://localhost:5173

LETTA_SECURE=true
LETTA_SERVER_PASSWORD=replace-with-a-long-random-password

LETTA_MEM_LIMIT=16g
LETTA_MEMSWAP_LIMIT=16g

# Local inference can be much slower than a hosted frontier model.
LETTA_LLM_REQUEST_TIMEOUT_SECONDS=600
LETTA_LLM_STREAM_TIMEOUT_SECONDS=1800

LETTA_AGENT_NAME=local-qwen-agent
LETTA_AGENT_TIMEZONE=Australia/Perth

# Letta-native provider handles.
LETTA_MODEL=ollama/qwen3.5:9b-q4_K_M
LETTA_EMBEDDING_HANDLE=ollama/nomic-embed-text:latest

# Gives ~15K tokens of headroom over the requested ~50K working context.
LETTA_CONTEXT_WINDOW_LIMIT=65536


# ---------------------------------------------------------------------------
# MCP
# ---------------------------------------------------------------------------

MCP_SERVER_NAME=business-mcp-bridge-v2
MCP_DISABLE_STDIO=false

# Update to the endpoint of your existing business MCP server.
BUSINESS_MCP_URL=http://10.0.10.110:8080/mcp

MCP_REMOTE_HOME=/var/lib/mcp-remote
MCP_CONNECT_TO_SERVER_TIMEOUT=120
MCP_LIST_TOOLS_TIMEOUT=120
MCP_EXECUTE_TOOL_TIMEOUT=120


# ---------------------------------------------------------------------------
# Bootstrap script
# ---------------------------------------------------------------------------

CONNECT_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=600
AGENT_PAGE_SIZE=200
MCP_TOOL_WAIT_SECONDS=120
MCP_TOOL_POLL_SECONDS=5

# "matching" removes only the configured agent and MCP server names.
# Use "all" only when deliberately clearing the Letta server.
LETTA_CLEANUP_SCOPE=matching

MCP_REMOTE_COMMAND=/usr/local/bin/letta-mcp-remote
MCP_REMOTE_TRANSPORT=http-only
